@page "/trips/locations"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using StripedBassFishingTool.Web.Services.FishingLogs
@using StripedBassFishingTool.Web.ViewModels.FishingLogs
@inject FishingTripService FishingTripService
@inject FishingLocationService FishingLocationService

<PageTitle>Fishing Locations</PageTitle>

<section class="page-header">
    <div>
        <a class="back-link" href="/trips">&larr; Back to Fishing Trips</a>
        <p class="eyebrow">Fishing Log</p>
        <h1>Fishing Locations</h1>
        <p class="text-muted page-intro">
            Manage reusable bodies-of-water locations used when logging trips and sessions.
        </p>
    </div>

    <div class="page-actions">
        <a class="btn btn-primary" href="/trips/locations/new">
            Add Location
        </a>
    </div>
</section>

@if (_isLoading)
{
    <div class="state-card">
        <h2>Loading locations...</h2>
        <p class="text-muted">Reading saved fishing locations.</p>
    </div>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">
        <strong>Could not load locations.</strong>
        <pre>@_errorMessage</pre>
    </div>
}
else
{
    <section class="filter-panel">
        <div class="filter-panel-header">
            <div>
                <h2>Location Filters</h2>
                <p class="text-muted">Narrow locations by body of water before editing or adding trip sessions.</p>
            </div>

            <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilterAsync" disabled="@(!_bodyOfWaterId.HasValue)">
                Clear
            </button>
        </div>

        <div class="filter-grid">
            <div class="form-field">
                <label for="bodyOfWater">Body of Water</label>
                <InputSelect id="bodyOfWater" class="form-select" @bind-Value="_bodyOfWaterId">
                    <option value="">All waters</option>
                    @foreach (var option in _lookups.BodiesOfWater)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="filter-actions">
            <button type="button" class="btn btn-primary" @onclick="ApplyFilterAsync">
                Apply Filter
            </button>
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-card">
            <span class="summary-label">Locations</span>
            <strong>@_locations.Count</strong>
        </div>

        <div class="summary-card">
            <span class="summary-label">Used In Sessions</span>
            <strong>@_locations.Count(x => x.SessionCount > 0)</strong>
        </div>

        <div class="summary-card">
            <span class="summary-label">Sensitive Spots</span>
            <strong>@_locations.Count(x => x.IsSensitiveSpot)</strong>
        </div>
    </section>

    @if (_locations.Count == 0)
    {
        <div class="state-card">
            <h2>No locations yet</h2>
            <p class="text-muted">Add locations you expect to reuse across trips, sessions, and historical filters.</p>
        </div>
    }
    else
    {
        <section class="location-grid">
            @foreach (var location in _locations)
            {
                <article class="location-card">
                    <div class="trip-card-header">
                        <div>
                            <span class="trip-date">
                                @location.BodyOfWaterName
                                @if (!string.IsNullOrWhiteSpace(location.State))
                                {
                                    <span>, @location.State</span>
                                }
                            </span>
                            <h2>@location.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(location.GeneralArea))
                            {
                                <p class="source-line">@location.GeneralArea</p>
                            }
                        </div>

                        @if (location.IsSensitiveSpot)
                        {
                            <span class="confidence-pill confidence-2">Sensitive</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(location.Description))
                    {
                        <p class="knowledge-summary">@location.Description</p>
                    }

                    <div class="trip-stats">
                        <span>@location.SessionCount session@(location.SessionCount == 1 ? "" : "s")</span>
                        @if (!string.IsNullOrWhiteSpace(location.DefaultStructureTypeName))
                        {
                            <span>@location.DefaultStructureTypeName</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(location.Notes))
                    {
                        <div class="lesson-strip">@location.Notes</div>
                    }

                    <div class="location-card-actions">
                        <a class="btn btn-outline-primary btn-sm" href="@($"/trips/locations/{location.FishingLocationId}/edit")">
                            Edit
                        </a>
                    </div>
                </article>
            }
        </section>
    }
}

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private long? _bodyOfWaterId;
    private FishingTripLookupViewModel _lookups = new();
    private IReadOnlyList<FishingLocationCardViewModel> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _lookups = await FishingTripService.GetLookupsAsync();
            _locations = await FishingLocationService.GetLocationCardsAsync(_bodyOfWaterId);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.ToString();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        _locations = await FishingLocationService.GetLocationCardsAsync(_bodyOfWaterId);
    }

    private async Task ClearFilterAsync()
    {
        _bodyOfWaterId = null;
        await ApplyFilterAsync();
    }
}

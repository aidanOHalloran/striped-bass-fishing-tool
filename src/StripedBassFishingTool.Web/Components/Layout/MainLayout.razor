@inherits LayoutComponentBase
@using StripedBassFishingTool.Web.Services.UserProfile
@using StripedBassFishingTool.Web.ViewModels.UserProfile
@inject UserProfileService UserProfileService

<div class="page @ThemeClass">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 app-top-row">
            @if (_profile is not null)
            {
                <div class="profile-summary">
                    <span class="profile-greeting">Welcome back,</span>
                    <strong>@_profile.Username</strong>
                </div>
            }

            <a class="settings-link"
               href="settings/profile"
               title="Edit profile settings"
               aria-label="Edit profile settings">
                ⚙
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private UserProfileEditViewModel? _profile;

    private string ThemeClass =>
        _profile?.DarkModeEnabled == true
            ? "theme-dark"
            : "theme-light";

    protected override async Task OnInitializedAsync()
    {
        _profile = await UserProfileService.GetOrCreateProfileAsync();
    }
}
